{
  "name": "arunai-sacred-soils-backend",
  "version": "1.0.0",
  "description": "REST API for Arunai Sacred Soils (Express + MySQL + JWT)",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node utils/initDb.js",
    "seed:admin": "node utils/seedAdmin.js",
    "db:verify": "node utils/verifyDb.js",
    "test:api": "node tests/api.test.js",
    "db:reset": "node utils/initDb.js --reset --yes",
    "db:docs": "node utils/dataDictionary.js",
    "test:db": "node tests/db.test.js",
    "test": "node tests/db.test.js && node tests/api.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  }
}

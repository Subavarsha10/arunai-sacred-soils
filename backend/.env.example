# Copy this file to ".env" (same folder) and fill in the values. Never commit ".env".
PORT=5000
NODE_ENV=development

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=arunai_sacred_soils

# Secret used to sign login tokens. REQUIRED, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma separated). Live Server uses 5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# Content-Security-Policy header (recommended). Use CSP=off only while debugging.
CSP=on

# Let this server also serve the ../frontend folder at http://localhost:5000
SERVE_FRONTEND=true

# Used only by "npm run seed:admin". Change the password before any real deployment.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@arunaisacredsoils.com
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=Admin@123
